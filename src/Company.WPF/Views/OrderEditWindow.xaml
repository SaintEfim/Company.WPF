<Window x:Class="Company.WPF.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Text="Дата:" Grid.Row="0" Grid.Column="0" Margin="0,5" />
    <DatePicker SelectedDate="{Binding Date}" Grid.Row="0" Grid.Column="1" Margin="5" />

    <TextBlock Text="Сумма:" Grid.Row="1" Grid.Column="0" Margin="0,5" />
    <TextBox Text="{Binding Amount}" Grid.Row="1" Grid.Column="1" Margin="5" />

    <TextBlock Text="Сотрудник:" Grid.Row="2" Grid.Column="0" Margin="0,5" />
    <ComboBox Grid.Row="2" Grid.Column="1" Margin="5"
              ItemsSource="{Binding AvailableEmployees}"
              SelectedItem="{Binding SelectedEmployee}"
              DisplayMemberPath="FullName" />

    <TextBlock Text="Контрагент:" Grid.Row="3" Grid.Column="0" Margin="0,5" />
    <ComboBox Grid.Row="3" Grid.Column="1" Margin="5"
              ItemsSource="{Binding AvailableContractors}"
              SelectedItem="{Binding SelectedContractor}"
              DisplayMemberPath="Name" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="0"
                Margin="0,10">
      <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="75" Margin="5" />
      <Button Content="Отмена" Command="{Binding CancelCommand}" Width="75" Margin="5" />
    </StackPanel>
  </Grid>
</Window>
