<Window x:Class="Company.WPF.Views.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models1="clr-namespace:Company.Domain.Models;assembly=Company.Domain.Abstractions"
        Title="Сотрудник" Height="250" Width="400"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <ObjectDataProvider x:Key="PositionEnumValues"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="models1:Position" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>

  <Grid Margin="10">
    <!-- остальное содержимое без изменений -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Text="ФИО:" Grid.Row="0" Grid.Column="0" Margin="0,5" />
    <TextBox Text="{Binding FullName}" Grid.Row="0" Grid.Column="1" Margin="5" />

    <TextBlock Text="Должность:" Grid.Row="1" Grid.Column="0" Margin="0,5" />
    <ComboBox ItemsSource="{Binding Source={StaticResource PositionEnumValues}}"
              SelectedItem="{Binding Position}" Grid.Row="1" Grid.Column="1" Margin="5" />

    <TextBlock Text="Дата рождения:" Grid.Row="2" Grid.Column="0" Margin="0,5" />
    <DatePicker SelectedDate="{Binding DateOfBirth}" Grid.Row="2" Grid.Column="1" Margin="5" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0"
                Margin="0,10">
      <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="75" Margin="5" />
      <Button Content="Отмена" Command="{Binding CancelCommand}" Width="75" Margin="5" />
    </StackPanel>
  </Grid>
</Window>
